{
  "name": "pg-safe-migrate-vscode",
  "displayName": "PG Safe Migrate",
  "description": "Find risky PostgreSQL SQL migrations in VS Code with lock warnings, risk analysis and safer migration guidance",
  "version": "0.9.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.cjs",
  "publisher": "sukoaa",
  "activationEvents": [
    "onLanguage:sql",
    "onCommand:pgSafeMigrate.lintFile",
    "onCommand:pgSafeMigrate.generatePlan"
  ],
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pgSafeMigrate.lintFile",
        "title": "PG Safe Migrate: Lint Current SQL File"
      },
      {
        "command": "pgSafeMigrate.generatePlan",
        "title": "PGSAFE: Generate Migration Plan"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pgSafeMigrate.lintFile",
          "when": "resourceExtname == .sql"
        },
        {
          "command": "pgSafeMigrate.generatePlan",
          "when": "resourceExtname == .sql"
        }
      ]
    },
    "configuration": {
      "title": "PG Safe Migrate",
      "properties": {
        "pgSafeMigrate.autoLint": {
          "type": "boolean",
          "default": true,
          "description": "Lint SQL files automatically when opened or saved."
        },
        "pgSafeMigrate.debounceMs": {
          "type": "integer",
          "default": 350,
          "minimum": 100,
          "description": "Delay in milliseconds before linting a saved SQL file."
        },
        "pgSafeMigrate.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable path used to run the CLI.",
          "scope": "machine"
        },
        "pgSafeMigrate.timeoutMs": {
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "Maximum time in milliseconds allowed for one SQL lint process."
        },
        "pgSafeMigrate.maxConcurrentLints": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 4,
          "description": "Maximum active CLI processes per extension host."
        },
        "pgSafeMigrate.maxFileSizeMB": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum saved SQL file size in MiB. Not a process memory limit."
        }
      }
    }
  },
  "scripts": {
    "build:standalone": "node build-standalone.cjs",
    "package:standalone": "npm run build:standalone && npm run verify:standalone && npx --yes @vscode/vsce@4.1.1 package --no-dependencies",
    "verify:standalone": "node verify-standalone.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/subodhsingh001/pg-safe-migrate.git"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "sql",
    "migration",
    "migration-linter",
    "database-safety",
    "prisma",
    "drizzle",
    "flyway",
    "zero-downtime",
    "locks"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}
