{
  "name": "pg-safe-migrate-vscode",
  "displayName": "PG Safe Migrate",
  "description": "Find risky PostgreSQL SQL migrations in VS Code with lock warnings, risk analysis and safer migration guidance",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.cjs",
  "publisher": "sukoaa",
  "activationEvents": [
    "onLanguage:sql",
    "onCommand:pgSafeMigrate.lintFile"
  ],
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pgSafeMigrate.lintFile",
        "title": "PG Safe Migrate: Lint Current SQL File"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pgSafeMigrate.lintFile",
          "when": "resourceExtname == .sql"
        }
      ]
    },
    "configuration": {
      "title": "PG Safe Migrate",
      "properties": {
        "pgSafeMigrate.autoLint": {
          "type": "boolean",
          "default": true,
          "description": "Lint SQL files automatically when opened or saved."
        },
        "pgSafeMigrate.debounceMs": {
          "type": "integer",
          "default": 350,
          "minimum": 100,
          "description": "Delay in milliseconds before linting a saved SQL file."
        },
        "pgSafeMigrate.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable path used to run the CLI."
        }
      }
    }
  },
  "scripts": {
    "build:standalone": "node build-standalone.cjs",
    "package:standalone": "npm run build:standalone && npx @vscode/vsce package --no-dependencies",
    "verify:standalone": "node verify-standalone.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/subodhsingh001/pg-safe-migrate.git"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "sql",
    "migration",
    "migration-linter",
    "database-safety",
    "prisma",
    "drizzle",
    "flyway",
    "zero-downtime",
    "locks"
  ]
}
