{
  "name": "@subodh001/pg-safe-migrate",
  "version": "2.5.0",
  "description": "Detect risky PostgreSQL schema migrations before deployment: SQL linting, lock analysis, risk scoring and CI reports for Prisma, Drizzle and Flyway",
  "type": "module",
  "bin": {
    "pg-safe-migrate": "bin/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node scripts/run-unit-tests.cjs",
    "test:integration": "node scripts/test-pg-matrix.cjs",
    "lint": "node bin/cli.js",
    "pack:check": "npm pack --dry-run",
    "test:release": "npm run test:unit && node test/release-smoke.cjs"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "migration",
    "linter",
    "prisma",
    "drizzle",
    "zero-downtime",
    "ast",
    "database-migration",
    "migration-linter",
    "schema-migration",
    "migration-safety",
    "database-safety",
    "postgres-locks",
    "flyway",
    "sarif"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "libpg-query": "^16.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "examples/",
    "scripts/test-pg-matrix.cjs",
    "scripts/orm-runner/verify.mjs",
    "scripts/orm-runner/package.json",
    "scripts/orm-runner/package-lock.json",
    "scripts/orm-runner/README.md",
    "ALL-MILESTONES-TESTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/RULES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subodhsingh001/pg-safe-migrate.git"
  },
  "bugs": {
    "url": "https://github.com/subodhsingh001/pg-safe-migrate/issues"
  },
  "homepage": "https://github.com/subodhsingh001/pg-safe-migrate#readme"
}
